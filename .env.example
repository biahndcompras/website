# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional BIA Home hero media overrides.
# The app ships with local defaults at:
#   /media/bia-origin-hero.mp4
#   /media/bia-origin-poster.jpg
# Set these when deploying a replacement or serving approved media from another host.
# VITE_BIA_HERO_VIDEO_URL="/media/bia-origin-hero.mp4"
# VITE_BIA_HERO_POSTER_URL="/media/bia-origin-poster.jpg"

# Optional BIA Home MotionStory media overrides.
# The app ships with local defaults at:
#   /media/bia-motion-story.mp4
#   /media/bia-motion-story-poster.jpg
# Set these only when the approved film or its poster frame is replaced.
# VITE_BIA_MOTION_STORY_VIDEO_URL="/media/bia-motion-story.mp4"
# VITE_BIA_MOTION_STORY_POSTER_URL="/media/bia-motion-story-poster.jpg"
